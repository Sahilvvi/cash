# Supabase (required)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Sentry error tracking (optional — app works without it)
# VITE_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# VITE_SENTRY_ENV="production"

# Offer18 credentials are server-side only.
# Set them with:
#   supabase secrets set OFFER18_API_KEY=...
#                        OFFER18_AFFILIATE_ID=...
#                        OFFER18_MERCHANT_ID=...
# Do NOT add VITE_OFFER18_* here — anything prefixed VITE_ is bundled
# into the frontend and publicly readable.
